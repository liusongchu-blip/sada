{
  "name": "sada-desktop",
  "productName": "SADA",
  "version": "0.1.0",
  "description": "SADA social entertainment desktop client",
  "author": "SADA",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "typecheck": "tsc --noEmit",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:smoke": "SADA_DESKTOP_SMOKE=1 node desktop/dev.mjs",
    "desktop:ui:smoke": "SADA_DESKTOP_UI_SMOKE=1 node desktop/dev.mjs",
    "desktop:pack": "npm run build && ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder --mac dir",
    "desktop:dmg": "npm run build && ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder --mac dmg",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "release:check": "npm run check && wrangler deploy --dry-run",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release --ignore-pattern .electron-builder-cache --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply sada-social-db --local",
    "db:seed:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 execute sada-social-db --local --file db/seed.sql",
    "db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply sada-social-db --remote",
    "db:migrate:staging": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --remote --config wrangler.staging.jsonc",
    "db:seed:staging": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 execute DB --remote --config wrangler.staging.jsonc --file db/seed.sql",
    "deploy:staging": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config wrangler.staging.jsonc"
  },
  "build": {
    "appId": "com.sada.social",
    "productName": "SADA",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/standalone/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "desktop/assets/icon.png",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "type": "module"
}
